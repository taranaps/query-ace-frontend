{
    "tags": {
      "allowUnknownTags": true
    },
    "source": {
      "include": ["src"],
      "includePattern": ".(js|jsx|ts|tsx)$",
      "excludePattern": "(node_modules/|docs)"
    },
    "opts": {
        "destination": "docs",
        "recurse": true,
      "verbose": true,
      "template": "node_modules/minami"
    },
    "templates": {
      "cleverLinks": true,
      "monospaceLinks": true
    }
  }
  